# Copy to piping.env — this feeds the piping-config ConfigMap.
#
# NON-SECRET VALUES ONLY. DATABASE_URL carries the database password,
# so it belongs in the piping-secret Secret along with OIDC_CLIENT_SECRET
# and ENCRYPTION_KEY. envFrom lists the secret after this ConfigMap, so
# anything set in both places resolves to the secret's value.

LISTEN_ADDR=:8080
LOG_LEVEL=info

# limits
MAX_BYTES=52428800
MAX_PAGES=100
MAX_COPIES=50
MAX_SEND_ATTEMPTS=5
SEND_TIMEOUT=5s

# sweeper: startup fails unless SWEEP_AGE_BOUND > SEND_TIMEOUT, and it warns
# below 2x
SWEEP_INTERVAL=1m
SWEEP_AGE_BOUND=2m
SWEEP_BATCH=100

# billing
COLOR_RATE=3
COLOR_THRESHOLD=0.0005
DEFAULT_QUOTA=250

SESSION_TTL=60m

# OIDC. The client id is not a secret; the client secret is.
# OIDC_REDIRECT_URI also determines the origin the upload endpoint accepts.
OIDC_CLIENT_ID=piping
OIDC_REDIRECT_URI=https://piping.example.mcgill.ca/auth/callback
OIDC_SCOPES=openid profile email
OIDC_DISCOVERY_URL=https://sso.example.mcgill.ca/.well-known/openid-configuration

# only consulted when discovery fails, and then all three are required
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USER_INFO_ENDPOINT=

# path to the smbclient -A credentials file projected from piping-secret
SMB_AUTH_FILE=/etc/piping/secret/smbauth

# set by CI; shown in the page footer
# PIPING_BUILD=
