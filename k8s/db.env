# Copy to db.env — this feeds the piping-db-config ConfigMap.
#
# NON-SECRET VALUES ONLY. POSTGRES_PASSWORD belongs in the piping-db-secret
# Secret, and must match the password in the app's DATABASE_URL.
#
# Do not set PGDATA: the image points it at /var/lib/postgresql/18/docker,
# a subdirectory of the mounted volume, and the entrypoint relies on that.

POSTGRES_DB=piping
POSTGRES_USER=piping
